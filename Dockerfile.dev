# Stage 1: Build custom controller and frontend from source
FROM node:22 AS builder

SHELL ["/bin/bash", "-c"]

RUN corepack enable && corepack prepare pnpm@10.22.0 --activate

# Install build tools needed for native addons (sqlite3, etc.)
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy everything (filtered by .dockerignore)
COPY . .

# Create stub for janitor bin (dist/ excluded by .dockerignore, pnpm needs it for bin link)
RUN mkdir -p packages/testing/janitor/dist && \
    echo "#!/usr/bin/env node" > packages/testing/janitor/dist/cli.js

# Install dependencies without lifecycle scripts, then rebuild native addons
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm rebuild || true
RUN cd node_modules/.pnpm/sqlite3@5.1.7/node_modules/sqlite3 && npx node-gyp rebuild || true

# Generate lezer parser files (gitignored in codemirror-lang-html, excluded by railway upload)
RUN cd packages/@n8n/codemirror-lang-html && pnpm run grammar:build

# Increase Node heap and reduce concurrency to avoid OOM during build
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Build only the packages we need: cli (controller) and editor-ui (frontend)
RUN npx turbo run build --filter=n8n --filter=n8n-editor-ui --concurrency=1

# Stage 2: Overlay onto official n8n image
FROM n8nio/n8n:latest

USER root

# Overlay custom backend controller
COPY --from=builder /build/packages/cli/dist/controllers/advanced-manager.controller.js /usr/local/lib/node_modules/n8n/dist/controllers/

# Overlay custom frontend build (includes AdvancedManager view + router)
COPY --from=builder /build/packages/frontend/editor-ui/dist/ /usr/local/lib/node_modules/n8n/node_modules/n8n-editor-ui/dist/

RUN chown -R node:node /usr/local/lib/node_modules/n8n/dist/controllers/ && \
    chown -R node:node /usr/local/lib/node_modules/n8n/node_modules/n8n-editor-ui/dist/

USER node
